// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       FitnessProfile?
  workoutPlans  GeneratedWorkoutPlan[]
  mealPlans     GeneratedMealPlan[]
  workoutLogs   WorkoutLog[]
  mealLogs      MealLog[]
  waterLogs     WaterIntakeLog[]
  progress      ProgressRecord[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FitnessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  age               Int
  gender            String
  height            Float
  weight            Float
  goal              String
  experienceLevel   String
  location          String
  daysPerWeek       Int
  duration          Int      // preferred workout duration in minutes
  focus             String   // target body focus
  dietaryPreference String
  restrictions      String?  // food restrictions or allergies
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  goal        String
  experience  String
  location    String
  focus       String
  exercises   Json     // List of exercises in this template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MealTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  goal              String
  dietaryPreference String
  meals             Json     // List of meals in this template
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedWorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  planData  Json     // The actual generated plan (weekly schedule, etc.)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedMealPlan {
  id        String   @id @default(cuid())
  userId    String
  planData  Json     // The actual generated meal plan
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  exercise    String
  sets        Int
  reps        Int
  weight      Float?
  notes       String?
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  mealType    String   // Breakfast, Lunch, Snack, Dinner
  mealName    String
  calories    Int?
  protein     Float?
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WaterIntakeLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  amount    Float    // in liters or ml
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressRecord {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weight    Float?
  waist     Float?
  hips      Float?
  notes     String?
  photoUrl  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
