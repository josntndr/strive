PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_this_with_a_secure_secret
DB_MODE=json
MONGO_URI=

# Strive Assistant (AI chat). If no key is set, a rule-based fallback is used.
# Put the REAL key only in backend/.env (which is gitignored) — never here.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_openai_api_key
AI_MODEL=gpt-4o-mini
